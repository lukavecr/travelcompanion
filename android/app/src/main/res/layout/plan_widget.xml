<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#2DD4A7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_spend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/day1_head"
        style="@style/WidgetDayHead"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/day1_body"
        style="@style/WidgetDayBody" />

    <TextView
        android:id="@+id/day2_head"
        style="@style/WidgetDayHead" />

    <TextView
        android:id="@+id/day2_body"
        style="@style/WidgetDayBody" />

    <TextView
        android:id="@+id/day3_head"
        style="@style/WidgetDayHead" />

    <TextView
        android:id="@+id/day3_body"
        style="@style/WidgetDayBody" />

    <!-- spodní lišta: kroky dnes + Start/Stop záznamu trasy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#C8D2CE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:textColor="#06231B"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
