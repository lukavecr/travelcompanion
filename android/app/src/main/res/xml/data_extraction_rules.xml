<?xml version="1.0" encoding="utf-8"?>
<!-- Android nesmí kopírovat data aplikace do záloh Google ani při přenosu na nový telefon:
     záloha řeší aplikace sama (šifrovaně), klíče v Keystore se stejně nepřenášejí. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
