<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#7FD1AE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_spend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/day1_head"
        style="@style/WidgetDayHead"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/day1_body"
        style="@style/WidgetDayBody" />

    <TextView
        android:id="@+id/day2_head"
        style="@style/WidgetDayHead" />

    <TextView
        android:id="@+id/day2_body"
        style="@style/WidgetDayBody" />

    <TextView
        android:id="@+id/day3_head"
        style="@style/WidgetDayHead" />

    <TextView
        android:id="@+id/day3_body"
        style="@style/WidgetDayBody" />
</LinearLayout>
